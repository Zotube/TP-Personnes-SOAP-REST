<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://tp.univ.tn/personnes"
           targetNamespace="http://tp.univ.tn/personnes"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- Modèle partagé par toutes les opérations -->
    <xs:complexType name="PersonneType">
        <xs:sequence>
            <xs:element name="id" type="xs:long" minOccurs="0"/>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="prenom" type="xs:string"/>
            <xs:element name="age" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <!-- 1. addPersonne -->
    <xs:element name="addPersonneRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="addPersonneResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 2. getPersonne -->
    <xs:element name="getPersonneRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="getPersonneResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 3. getAllPersonnes -->
    <xs:element name="getAllPersonnesRequest">
        <xs:complexType>
            <xs:sequence/>
        </xs:complexType>
    </xs:element>
    <xs:element name="getAllPersonnesResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"
                            minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 4. updatePersonne -->
    <xs:element name="updatePersonneRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="updatePersonneResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="personne" type="tns:PersonneType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 5. deletePersonne -->
    <xs:element name="deletePersonneRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="deletePersonneResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
